# Dihasilkan oleh scripts/gen-htaccess.mjs — jangan diedit tangan.
# Sumbernya REDIRECTS di next.config.ts.

# ── Kompresi ──────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ── Cache ────────────────────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On
  # Aset ber-hash dari Next aman di-cache selamanya.
  <FilesMatch "\.(js|css|woff2)$">
    ExpiresDefault "access plus 1 year"
    Header set Cache-Control "public, immutable"
  </FilesMatch>
  <FilesMatch "\.(webp|jpg|jpeg|png|gif|svg|ico)$">
    ExpiresDefault "access plus 6 months"
  </FilesMatch>
  # HTML harus selalu divalidasi ulang, kalau tidak deploy baru tak terlihat.
  <FilesMatch "\.html$">
    ExpiresDefault "access plus 0 seconds"
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

# ── Kartu Open Graph ─────────────────────────────────────
# next/og menulisnya tanpa ekstensi; tanpa baris ini Apache
# menyajikannya sebagai octet-stream dan pratinjau WhatsApp kosong.
<IfModule mod_mime.c>
  <FilesMatch "opengraph-image$">
    ForceType image/png
  </FilesMatch>
</IfModule>

# ── Redirect permanen dari URL situs lama ────────────────
<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteRule ^blog/0/?$ /blog/9th-tpo-general-assembly-common-prosperity-in-tourism-through-open-partnership-2 [R=301,L]
  RewriteRule ^blog/1/?$ /blog/indonesia-city-expo-2022-padang-7-10-agustus-2022 [R=301,L]
  RewriteRule ^blog/2/?$ /blog/tourism-trade-investment-expo-2022 [R=301,L]
  RewriteRule ^blog/3/?$ /blog/event-g-20-kolaborasi-fashion-show-2022 [R=301,L]
  RewriteRule ^blog/4/?$ /blog/gebyar-ekonomi-kreatif-bogor-creative-center-22-23-december-2022 [R=301,L]
  RewriteRule ^blog/5/?$ /blog/inacraft-2023-1-5-maret-jakarta-convention-center [R=301,L]
  RewriteRule ^blog/6/?$ /blog/ragam-pesona-batik-bogor-chapter-1-dan-2-2022-2023 [R=301,L]
  RewriteRule ^blog/7/?$ /blog/talk-show-persembahan-srikandi-wika-2023-memayu-hayuning-bawana-bangkitlah-batik [R=301,L]
  RewriteRule ^blog/8/?$ /blog/cerita-nusantara-unveiling-the-essence-of-indonesia-artistry-kemenkopukm-2023 [R=301,L]
  RewriteRule ^blog/9/?$ /blog/youtube-rewind-2023 [R=301,L]
  RewriteRule ^blog/10/?$ /blog/batikorganik-wakili-jawa-barat-dalam-program-nasional-bangun-wirausaha-perempuan [R=301,L]
  RewriteRule ^blog/11/?$ /blog/kolaborasi-hebat-ppk-ormawa-founder-batik-organik-luncurkan-kub-tumbuh-untuk-eko [R=301,L]
  RewriteRule ^blog/12/?$ /blog/couplepreuner-tda-bogor-resmikan-kelompok-usaha-bersama-tumbuh-batikorganik [R=301,L]
  RewriteRule ^blog/13/?$ /blog/kub-tumbuh-diluncurkan-di-desa-cipaku-dorong-pemberdayaan-ekonomi-perempuan-lewa [R=301,L]
  RewriteRule ^blog/14/?$ /blog/kub-tumbuh-mewujudkan-ekonomi-inklusif-dan-ramah-lingkungan [R=301,L]
  RewriteRule ^blog/15/?$ /blog/cerita-ana-khairani-membangun-batik-organik-hingga-diminati-pasar-global [R=301,L]
  RewriteRule ^blog/16/?$ /blog/batik-organik-menjalankan-bisnis-inklusif-dengan-model-pentahelix [R=301,L]
  RewriteRule ^blog/17/?$ /blog/tantangan-dan-strategi-berbisnis-inklusif-ala-founder-batik-organik [R=301,L]
  RewriteRule ^gallery-review/?$ /gallery [R=301,L]
  RewriteRule ^partnership/corpo/?$ https://batikorganikcorporate.id [R=301,L]

  # trailingSlash: true — arahkan /path ke /path/ supaya tidak ada URL kembar.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+[^/])$ /$1/ [R=301,L]
</IfModule>

# ── Halaman 404 ──────────────────────────────────────────
ErrorDocument 404 /404.html
